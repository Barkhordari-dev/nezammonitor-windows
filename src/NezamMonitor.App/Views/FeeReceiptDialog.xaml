<Window x:Class="NezamMonitor.App.Views.FeeReceiptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="دریافتی" Height="470" Width="580"
        WindowStartupLocation="CenterOwner" FlowDirection="RightToLeft"
        FontFamily="B Nazanin" FontSize="14"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <Border Margin="12" Background="White" CornerRadius="8" BorderBrush="#BDC3C7" BorderThickness="1" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="💰 ثبت دریافتی" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="#1B3147"/>
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="36"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="تاریخ واریز:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="DateBox" Height="28" VerticalContentAlignment="Center" Padding="6,0"
                         FontFamily="B Nazanin" FontSize="14" ToolTip="مثال: 1404/07/10"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="مبلغ واریز:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Grid.Row="0" Grid.Column="4" x:Name="AmountBox" Height="28" VerticalContentAlignment="Center" Padding="6,0"
                         FontFamily="B Nazanin" FontSize="14" ToolTip="مثال: 23,158,293"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="توضیح تغییرات:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="4" x:Name="ChangesBox" Height="28" VerticalContentAlignment="Center" Padding="6,0"
                         FontFamily="B Nazanin" FontSize="14" IsReadOnly="True" Background="#F8F9FA" Foreground="#7F8C8D"/>
            </Grid>
            <Border Grid.Row="2" Background="#FEF9E7" CornerRadius="6" Padding="10,6" Margin="0,0,0,8" BorderBrush="#F0D27A" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" x:Name="AdvanceCheck" Content="واریزی علی‌الحساب" FontWeight="Bold" FontSize="14" Foreground="#7D6608" VerticalAlignment="Center"
                              Checked="AdvanceCheck_Changed" Unchecked="AdvanceCheck_Changed"/>
                    <TextBlock Grid.Column="1" x:Name="AdvanceHint" Text="← مرتبط با ردیف‌های تایید شده دارای تاریخ شروع" Foreground="#7D6608" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" Visibility="Collapsed"/>
                </Grid>
            </Border>
            <Border Grid.Row="3" BorderBrush="#D5D8DC" BorderThickness="1" CornerRadius="6" Padding="8" Background="#F8F9FA">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="RelatedHeader" Text="تاریخ‌های مرتبط (ستون آغاز — فقط پرداخت شده):" FontWeight="Bold" Margin="0,0,0,6" Foreground="#2C3E50"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="180">
                        <StackPanel x:Name="EndDatePanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
                <Button Content="✓ تایید" Width="90" Height="32" Background="#27AE60" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" Click="Ok_Click"/>
                <Button Content="✕ انصراف" Width="90" Height="32" Background="#95A5A6" Foreground="White" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
