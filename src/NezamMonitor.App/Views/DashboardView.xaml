<UserControl x:Class="NezamMonitor.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="BorderBrush" Value="#E8E8E8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="1" Opacity="0.1" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="QuickActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3498DB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="14,10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2980B9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="20" VerticalScrollBarVisibility="Auto">
        <StackPanel FlowDirection="RightToLeft">

            <!-- Header -->
            <TextBlock Text="📊 داشبورد" FontSize="{DynamicResource HeadingFontSize}"
                       FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <!-- ═══ Statistics — CENTERED ═══ -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📈 آمار کلی" FontSize="{DynamicResource FontSize}"
                               FontWeight="Bold" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel HorizontalAlignment="Center" MinWidth="100">
                                <TextBlock Text="📋" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalCases}" FontSize="26" FontWeight="Bold"
                                           Foreground="#2C3E50" HorizontalAlignment="Center"/>
                                <TextBlock Text="پرونده" FontSize="{DynamicResource LabelFontSize}"
                                           Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel HorizontalAlignment="Center" MinWidth="100">
                                <TextBlock Text="👷" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalEngineers}" FontSize="26" FontWeight="Bold"
                                           Foreground="#3498DB" HorizontalAlignment="Center"/>
                                <TextBlock Text="ناظرین" FontSize="{DynamicResource LabelFontSize}"
                                           Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel HorizontalAlignment="Center" MinWidth="100">
                                <TextBlock Text="💰" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalFees}" FontSize="26" FontWeight="Bold"
                                           Foreground="#E67E22" HorizontalAlignment="Center"/>
                                <TextBlock Text="حق‌الزحمه" FontSize="{DynamicResource LabelFontSize}"
                                           Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}">
                            <StackPanel HorizontalAlignment="Center" MinWidth="100">
                                <TextBlock Text="📄" FontSize="22" HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalReports}" FontSize="26" FontWeight="Bold"
                                           Foreground="#9B59B6" HorizontalAlignment="Center"/>
                                <TextBlock Text="گزارش" FontSize="{DynamicResource LabelFontSize}"
                                           Foreground="#7F8C8D" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ═══ Case Status — RIGHT ═══ -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="📋 وضعیت پرونده‌ها" FontSize="{DynamicResource FontSize}"
                               FontWeight="Bold" Margin="0,0,0,12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Specs -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="✅" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="با مشخصات:" VerticalAlignment="Center" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CasesWithSpecs}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="بدون مشخصات:" VerticalAlignment="Center" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CasesWithoutSpecs}" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{Binding CasesWithoutSpecs, Converter={StaticResource ZeroToGrayConverter}}"/>
                        </StackPanel>

                        <!-- Engineers -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="✅" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="با ناظرین:" VerticalAlignment="Center" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CasesWithEngineers}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="بدون ناظرین:" VerticalAlignment="Center" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CasesWithoutEngineers}" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{Binding CasesWithoutEngineers, Converter={StaticResource ZeroToGrayConverter}}"/>
                        </StackPanel>

                        <!-- Fees -->
                        <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="✅" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="با حق‌الزحمه:" VerticalAlignment="Center" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CasesWithFees}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="بدون حق‌الزحمه:" VerticalAlignment="Center" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CasesWithoutFees}" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{Binding CasesWithoutFees, Converter={StaticResource ZeroToGrayConverter}}"/>
                        </StackPanel>

                        <!-- Reports -->
                        <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="✅" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="با گزارش:" VerticalAlignment="Center" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CasesWithReports}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal">
                            <TextBlock Text="⚠️" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="بدون گزارش:" VerticalAlignment="Center" FontSize="{DynamicResource LabelFontSize}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding CasesWithoutReports}" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{Binding CasesWithoutReports, Converter={StaticResource ZeroToGrayConverter}}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ═══ Quick Actions — CENTERED ═══ -->
            <Border Style="{StaticResource SectionBorder}">
                <StackPanel>
                    <TextBlock Text="🚀 دسترسی سریع" FontSize="{DynamicResource FontSize}"
                               FontWeight="Bold" Margin="0,0,0,12" HorizontalAlignment="Center"/>
                    <WrapPanel HorizontalAlignment="Center">
                        <Button Style="{StaticResource QuickActionButton}" Margin="5"
                                Click="GoToUpdate_Click">
                            <StackPanel>
                                <TextBlock Text="⚙️" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="شروع استخراج" FontSize="12" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickActionButton}" Margin="5"
                                Background="#E67E22" Click="GoToFollowUp_Click">
                            <StackPanel>
                                <TextBlock Text="📌" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="پیگیری" FontSize="12" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickActionButton}" Margin="5"
                                Background="#27AE60" Click="GoToExcel_Click">
                            <StackPanel>
                                <TextBlock Text="📤" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="خروجی اکسل" FontSize="12" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource QuickActionButton}" Margin="5"
                                Background="#9B59B6" Click="GoToCases_Click">
                            <StackPanel>
                                <TextBlock Text="📋" FontSize="18" HorizontalAlignment="Center"/>
                                <TextBlock Text="پرونده‌ها" FontSize="12" HorizontalAlignment="Center"
                                           TextWrapping="Wrap" TextAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
